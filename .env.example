# openapi.kiwoom.com 에서 REST API 사용신청 후 발급받은 값을 입력
KIWOOM_APPKEY=
KIWOOM_SECRETKEY=
# 모의투자 계좌면 true, 실계좌면 false
KIWOOM_IS_MOCK=false

# run-trading(실주문 매매 루프) 전용 — 아래 값이 없으면 run-trading은 시작하지 않음
# 하루 동안 감내 가능한 최대 손실액(원). 초과 시 kill switch가 자동으로 신규 진입을 막음
MAX_DAILY_LOSS_KRW=
# 텔레그램 봇으로 체결/오류/kill switch 알림을 받으려면 BotFather로 봇 생성 후 입력
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 선택: run-trading --total-capital 기본값(원). 미설정 시 10,000,000
TOTAL_CAPITAL_KRW=
