       "right": {"kind": "ind", "name": "sma", "params": {"src": "close", "n": {"param": "long"}}}}
    ]},
    "exit": {"logic": "any", "items": [
      {"left": {"kind": "ind", "name": "sma", "params": {"src": "close", "n": {"param": "short"}}}, "op": "cross_below",
       "right": {"kind": "ind", "name": "sma", "params": {"src": "close", "n": {"param": "long"}}}}
    ]}
  },
  "market_filter": null,
  "exits": {},
  "portfolio": {"initial_capital": 10000000, "max_positions": 5, "sizing": "equal_slot_fixed", "max_weight_pct": 25, "rank_by": "value", "random_seed": 42},
  "params": {
    "short": {"default": 5, "min": 3, "max": 20, "step": 1},
    "long": {"default": 20, "min": 10, "max": 120, "step": 5}
